NODE_ENV=development
PORT=3000

MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=spreebuddy

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Storefront URL, used to build the Stripe success/cancel return URLs.
APP_URL=http://localhost:5173

# Stripe. Test keys are enough; without STRIPE_SECRET_KEY the payment routes
# answer 503 and the rest of the API is unaffected.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen --forward-to localhost:3000/api/v1/payments/webhook`
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_CURRENCY=usd

# OpenRouter (OpenAI-compatible). openrouter/free auto-routes to a free tool-calling model.
OPENROUTER_API_KEY=xxxxxxxxxxxxx
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_NAME=SpreeBuddy
# Set OPENROUTER_APP_URL only if you WANT the app listed on OpenRouter's public ranking
# OPENROUTER_APP_URL=https://your-app-url.com

CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_BUCKET=your-bucket-name
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com